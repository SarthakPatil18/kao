# === PROVENANCE Environment Variables ===
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# SerpApi — reverse image search (https://serpapi.com, 100 free/month)
SERPAPI_KEY=your_serpapi_key_here

# Bing Visual Search — fallback (optional)
BING_API_KEY=your_bing_key_here_optional

# Pinata — IPFS storage (https://pinata.cloud, 1 GB free)
PINATA_JWT=your_pinata_jwt_here

# Polygon Amoy Testnet
RPC_URL=https://rpc-amoy.polygon.technology/
PRIVATE_KEY=your_testnet_private_key_here
CONTRACT_ADDRESS=deployed_contract_address_here
